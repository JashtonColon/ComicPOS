    private static string GroupLabelFor(Issue issue, string sortKey) => sortKey switch
    {
        SortPublisher => string.IsNullOrWhiteSpace(issue.Publisher) ? "(Unknown Publisher)" : issue.Publisher,
        SortFoc => issue.FocDate?.ToString("MMMM yyyy") ?? "(No FOC Date)",
        SortTitle => issue.Series.Name,
        _ => issue.ReleaseDate?.ToString("MMMM yyyy") ?? "(No Release Date)"
    };

    private void RefreshGrid()
    {
        UpdateStatusLabel();

        IEnumerable<Issue> issues = AutoFetch.GetNewBooks();

        var searchText = _search.Trim();
        if (searchText.Length > 0)
        {
            issues = issues.Where(i =>
                i.Series.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(i.Publisher) && i.Publisher.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
        }

        if (_typeFilter == TypeFilterSingle)
            issues = issues.Where(i => i.Type == IssueType.SingleIssue);
        else if (_typeFilter == TypeFilterCollected)
            issues = issues.Where(i => i.Type == IssueType.CollectedEdition);

        IEnumerable<Issue> ordered = _sortBy switch
        {
            SortPublisher => issues.OrderBy(i => i.Publisher).ThenBy(i => i.Series.Name).ThenBy(i => i.IssueNumber),
            SortFoc => issues.OrderBy(i => i.FocDate ?? DateOnly.MaxValue).ThenBy(i => i.Series.Name),
            SortTitle => issues.OrderBy(i => i.Series.Name).ThenBy(i => i.IssueNumber),
            _ => issues.OrderBy(i => i.ReleaseDate ?? DateOnly.MaxValue).ThenBy(i => i.Series.Name)
        };

        var orderedList = ordered.ToList();

        var monthCapableSort = _sortBy == SortRelease || _sortBy == SortFoc;
        _showMonthTabs = monthCapableSort;

        if (monthCapableSort)
        {
            var months = orderedList.Select(i => GroupLabelFor(i, _sortBy)).Distinct().ToList();
            _monthTabs = months
                .OrderBy(label => DateTime.TryParseExact(label, "MMMM yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt) ? dt : DateTime.MaxValue)
                .ToList();

            if (!_monthFilterInitialized)
            {
                // First load (or just after a sort change): default to
                // the current month instead of "All", so old months stay
                // out of sight until explicitly asked for. Falls back to
                // "All" only if there's genuinely nothing for this month.
                _selectedMonthLabel = _monthTabs.Contains(_currentMonthLabel) ? _currentMonthLabel : null;
                _monthFilterInitialized = true;
            }
            else if (_selectedMonthLabel != null && !_monthTabs.Contains(_selectedMonthLabel))
            {
                _selectedMonthLabel = null;
            }

            if (_selectedMonthLabel != null)
                orderedList = orderedList.Where(i => GroupLabelFor(i, _sortBy) == _selectedMonthLabel).ToList();

            // Task #85: week pills, computed from whatever's left in the
            // currently-selected month only (so "weeks" always means
            // "weeks within this month", never the whole list) - and only
            // once a specific month is actually picked; "All months"
            // would mix in weeks from a year-plus of history with no
            // month to scope them to.
            if (_selectedMonthLabel != null)
            {
                _weekStarts = orderedList
                    .Select(GroupWeekFor)
                    .Where(w => w != DateOnly.MaxValue)
                    .Distinct()
                    .OrderBy(w => w)
                    .ToList();
                if (_selectedWeekStart != null && !_weekStarts.Contains(_selectedWeekStart.Value))
                    _selectedWeekStart = null;
                if (_selectedWeekStart != null)
                    orderedList = orderedList.Where(i => GroupWeekFor(i) == _selectedWeekStart.Value).ToList();
            }
            else
            {
                _weekStarts = new List<DateOnly>();
                _selectedWeekStart = null;
            }
        }
        else
        {
            _monthTabs = new List<string>();
            _weekStarts = new List<DateOnly>();
            _selectedWeekStart = null;
        }

        _totalIssueCount = orderedList.Count;
        _totalPages = Math.Max(1, (int)Math.Ceiling(_totalIssueCount / (double)PageSize));
        if (_currentPage > _totalPages) _currentPage = _totalPages;
        if (_currentPage < 1) _currentPage = 1;
        var pageList = orderedList.Skip((_currentPage - 1) * PageSize).Take(PageSize).ToList();

        _displayRows = new List<DisplayRow>();
        string? lastGroupValue = null;
        var showInlineHeader = _sortBy != SortTitle && !(monthCapableSort && _selectedMonthLabel != null);

        foreach (var issue in pageList)
        {
            var groupValue = GroupLabelFor(issue, _sortBy);
            if (showInlineHeader && groupValue != lastGroupValue)
            {
                _displayRows.Add(new DisplayRow { IsHeader = true, HeaderText = groupValue });
                lastGroupValue = groupValue;
            }
            _displayRows.Add(new DisplayRow { IsHeader = false, Issue = issue });
        }
    }

    private async Task RunCheckNow()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Checking for new issues... this can take a minute.";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.CheckForNewIssues());
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Check failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Checked {result.SeriesChecked} series, linked {result.SeriesAutoLinked} new one(s), added {result.NewIssuesAdded} new issue(s).";
            if (result.Errors.Count > 0)
                summary += " Some series had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

