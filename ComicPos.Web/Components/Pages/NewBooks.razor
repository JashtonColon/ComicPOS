@page "/new-books"
@using System.Globalization
@using ComicPos.Core.Models
@using ComicPos.Core.Services
@inject IAutoFetchService AutoFetch
@inject IJSRuntime JS
@inject IServiceScopeFactory ScopeFactory
@inject ComicPos.Web.Services.NewBooksStatusContext StatusContext
@rendermode InteractiveServer

<PageTitle>New Books - Comic POS</PageTitle>

<div class="page-header">
    <h1>New Books</h1>
</div>

<div class="toolbar">
    <ClearableSearchBox Value="@_search" Placeholder="Search New Books by series or publisher..." OnInput="OnSearchInput" />
    <div style="display:flex;gap:10px;align-items:center">
        <select value="@_sortBy" @onchange="OnSortChanged">
            <option value="@SortRelease">Release Date</option>
            <option value="@SortFoc">FOC Date</option>
            <option value="@SortPublisher">Publisher</option>
            <option value="@SortTitle">Title</option>
        </select>
        @* Added 2026-11-24, user feedback: no way to separate single issues
           from trades/HCs/omnibuses on this screen at all - everything the
           Lunar importer's TP/HC/collected-edition support (also added
           2026-11-24) brings in shows mixed in with ongoing single issues,
           with nothing to tell them apart except reading each title. *@
        <select value="@_typeFilter" @onchange="OnTypeFilterChanged" title="Filter by Single Issue vs Collected Edition (TP/HC/Omnibus/etc.)">
            <option value="@TypeFilterAll">All Types</option>
            <option value="@TypeFilterSingle">Single Issues</option>
            <option value="@TypeFilterCollected">Collected Editions</option>
        </select>
        <!-- Added 2026-11-27 - the store's own "one button that gets
             both [Lunar and PRH], all the way back to when they first
             started doing solicits" request. Chains BackfillAllLunarHistory
             + FetchAllAvailablePrhCatalogsFromWebsite + a PRH cover-variant
             catch-up pass into one combined run - see
             AutoFetchService.FetchAllHistoryBothDistributors's own doc
             comment for why running them in this fixed order also handles
             "duplicates between the two distributors" for free (whichever
             source reaches a series name first keeps it; the other
             source's issues attach to that same row). This is the single
             longest-running button on this page - potentially hours, not
             minutes - so the confirm() below says so plainly. Only ever
             adds/updates inventory; nothing is deleted. -->
        <button class="btn-primary btn-sm" disabled="@_checking" @onclick="RunFetchAllHistoryBothDistributors" title="Runs Backfill All Lunar History, then Fetch All Available PRH Catalogs, then a PRH cover-variant catch-up pass, one after another, as one combined operation - everything both distributors have, back to the start of each one's own available history. Can take a long time (potentially hours). Only ever adds/updates inventory; nothing is deleted.">Fetch Everything (Lunar + PRH, Full History)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRescan">Re-scan Existing</button>
        <!-- Metron is now the primary discovery source (2026-11-22),
             replacing LOCG in that role - a plain token-authenticated
             REST API with no Cloudflare check to click through and a
             far gentler, documented rate limit than LOCG's own ~4-5
             minute AJAX quota window. Pulls a rolling window (recent
             past through several months out) so FOC deadlines surface
             with real lead time, not just this week's shipping books.
             Re-scan Existing (Comic Vine/Metron/GCD) still runs
             separately as the cover-art/volume-link fallback for
             already-known series. RunCheckNow/AutoFetch.
             CheckForNewIssues (the original ComicList-based path) and
             RunLocgBackfill are both still here in code, just not the
             primary button any more - LOCG is kept as a manual fallback
             underneath for whatever Metron doesn't have on file. -->
        <button class="btn-primary btn-sm" disabled="@_checking" @onclick="RunMetronCheckNow" title="Pulls every issue Metron has on file with a street date from 2 weeks ago through 4 months out - recent misses plus enough lead time to see FOC deadlines coming. A plain REST API call, no browser window needed.">Check Now (Metron)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunMetronBackfillYear" title="Pulls all of @DateTime.Today.Year from Metron in one go - for rebuilding history after a catalog reset, not routine use.">Backfill @DateTime.Today.Year (Metron)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunLocgBackfill" title="Fallback only - pulls every week of @DateTime.Today.Year from League of Comic Geeks. Opens a real Chrome window and needs an occasional manual Cloudflare click; LOCG only lets a request through every few minutes, so a full year can take several hours.">Check Now (LOCG, fallback)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunCheckForNewIssues" title="A second fallback, independent of BOTH Metron and LOCG - checks comiclist.info's weekly list, its Extended Forecast, comicade.com's FOC catalogue, and Comic Vine's new-#1 discovery. All four are plain HTTP/REST calls - no Cloudflare, no browser window, nothing to click through. This was the original Check Now before Metron existed; still fully wired up, just not the default anymore.">Check Now (no Cloudflare)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRetryMetronEnrichment" title="One-time catch-up for issues Metron already added whose price/UPC/description never came through (a detail-call failure when they were first added) - fills those in and pulls in any cover variants that were missed too. Only needs running once per affected batch, not routine.">Retry Metron Enrichment</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRetryMetronEnrichmentTest" title="Same as Retry Metron Enrichment, but stops after 5 issues - use this first to sanity-check a change (like the Metron API retry/diagnostics fix) in under a minute instead of committing to the full multi-hour run blind.">Retry Metron Enrichment (Test 5)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRetryLocgEnrichmentTest" title="Same job as Retry Metron Enrichment, but sourced from LOCG instead - use this while Metron is blocked. Stops after 2 issues so you can check the result against LOCG's own site before running the full batch. Each issue needing a new LOCG week can take several minutes (LOCG's own rate limit), so this is slower per-issue than the Metron version - kept small on purpose.">Retry LOCG Enrichment (Test 2)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRetryComicadeEnrichmentSpecific" title="Hand-picked check, not a random sample - runs comicade.com's FOC catalogue (one of the no-Cloudflare sources, real UPC included) against exactly two known issues (Absolute Wonder Woman #26, Absolute Flash #21) so you can compare the result by hand. Updates whatever's on file for these two either way. Comicade's own catalogue is forward-looking only - if either issue already shipped, it may not be found there.">Check Comicade (Wonder Woman #26 + Flash #21)</button>
        <!-- Added 2026-11-24 - a distributor's own weekly release file
             (real UPC/price/publisher/description/FOC date/street date,
             PLUS a real embedded cover photo per row) read directly, with
             nothing to scrape and nothing rate-limited or Cloudflare-
             guarded. See IAutoFetchService.ImportLunarDistributionRelease.
             Styled as a label wrapping a hidden InputFile so it matches
             the other buttons instead of showing the browser's default
             file-input control. -->
        <label class="btn-primary btn-sm" style="cursor:pointer" title="Reads a Lunar Distribution weekly release .xlsx file directly - real UPC, price, publisher, FOC date, street date, and even the cover photo for every row, with nothing to scrape or rate-limit against. Pick the file your distributor sends you each week.">
            Import Lunar Release (.xlsx)
            <InputFile OnChange="OnLunarFileSelected" accept=".xlsx" style="display:none" disabled="@_checking" />
        </label>
        <!-- Added 2026-11-24 - downloads this week's release file AND the
             current FOC file straight from lunardistribution.com itself
             (a plain, cookie-less GET - see AutoFetchService.
             FetchLunarReleaseFromWebsite), so there's no manual
             download+upload step at all. The button above still exists
             for whenever the site's layout changes and this breaks, or
             for a file received some other way (e.g. emailed directly). -->
        <button class="btn-primary btn-sm" disabled="@_checking" @onclick="RunLunarWebsiteFetch" title="Downloads this week's release file AND the current FOC file directly from lunardistribution.com - no file to save or upload yourself. Reads the same two dates the site's own 'Product Data File' buttons use right now.">Fetch Lunar Release (auto)</button>
        <!-- Added 2026-11-25 - PRH's own "Comics Retail" solicitation
             spreadsheet: already a clean, named-column table (ISBN/UPC,
             Title, Creators, Imprint, price, Format, FOC Date, On-Sale
             Date), covering PRH's FULL Direct Market distribution list
             (Marvel, DC, Dark Horse, IDW, Oni Press, Kodansha, Seven
             Seas, Titan Books and many more - not just Penguin Random
             House's own imprints), not just a PRH-specific feed. See
             IAutoFetchService.ImportPrhCatalogRelease. No embedded cover
             photo in this one (unlike Lunar) - covers come from the
             existing Comic Vine auto-link pass instead, same as any
             other source without a photo of its own. Same hidden-
             InputFile-under-a-label styling as the Lunar button above. -->
        <label class="btn-primary btn-sm" style="cursor:pointer" title="Reads PRH's Comics Retail solicitation spreadsheet directly - ISBN/UPC, price, publisher, FOC date, and on-sale date for every title, covering PRH's full Direct Market distribution list (Marvel, DC, Dark Horse, IDW, Oni Press, Kodansha, and many more), not just PRH's own imprints. No cover photos in this file - those get filled in by Comic Vine auto-linking afterward.">
            Import PRH Catalog (.xlsx)
            <InputFile OnChange="OnPrhCatalogFileSelected" accept=".xlsx" style="display:none" disabled="@_checking" />
        </label>
        <!-- Added 2026-11-25/26 - downloads the catalog straight from
             prhcomics.com itself instead of needing the file saved and
             uploaded by hand: reads the catalog-landing-page, replays
             the same WordPress-AJAX-plus-nonce chain its own "Download
             Excel Spreadsheet" button performs, and feeds the result
             through the exact same ImportPrhCatalogRelease pipeline as
             the manual upload above. See AutoFetchService.
             FetchPrhCatalogFromWebsite and PrhWebsiteFetcher's own class
             comment for the full chain. catalogCode is PRH's "YYYY-MM"
             solicitation-month code - defaults to next month (the
             catalog that's normally open for ordering right now), but
             stays a plain text box since PRH links to several months at
             once rather than exposing one single "current" one the way
             lunardistribution.com's homepage does. The manual upload
             button above still exists for whenever prhcomics.com's
             layout changes and this breaks, or for a file received some
             other way. -->
        <input type="text" class="form-control form-control-sm" style="width:90px;display:inline-block" @bind="_prhCatalogCode" disabled="@_checking" title="PRH catalog code, YYYY-MM (e.g. 2026-12)" />
        <button class="btn-primary btn-sm" disabled="@_checking" @onclick="RunPrhWebsiteFetch" title="Downloads the Comics Retail catalog for the code above directly from prhcomics.com - no file to save or upload yourself.">Fetch PRH Catalog (auto)</button>
        <!-- Added 2026-11-26 - the store asked for every available month,
             not just one at a time. Discovers every catalog code
             prhcomics.com's own public archive currently lists (confirmed
             live it runs 2021-06 through whatever's newest right now -
             60+ catalogs) and fetches each one, same spirit as Backfill
             All Lunar History below - gated behind a confirm() for the
             same reason (a lot of requests, takes a while), and also only
             ever adds/updates inventory, never deletes. See
             AutoFetchService.FetchAllAvailablePrhCatalogsFromWebsite. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunFetchAllPrhCatalogs" title="Finds and downloads EVERY catalog prhcomics.com's own archive currently lists (2021 through now, 60+ months) instead of just the one code above. Can take a long time; only ever adds/updates inventory, never deletes anything.">Fetch All Available PRH Catalogs</button>
        <!-- Added 2026-11-24, same night as the fix above - a one-time
             cleanup pair for whatever duplicate series the bug already
             created before the fix landed (a series split into "Name"
             and "Name (2024)" rows). Find is read-only; Merge actually
             changes the database, so it's gated behind a JS confirm()
             and meant to be run only after checking Find's own output. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunFindDuplicateSeries" title="Read-only - lists any series that look like they got split into two rows (e.g. by the 2026-11-24 Lunar '(YYYY)' title-parsing bug), with issue counts for each, so you can see what's there before merging anything.">Find Duplicate Series</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunMergeDuplicateSeries" title="Actually merges whatever Find Duplicate Series turns up - combines issues/covers onto whichever row looks most established and deletes the now-empty duplicate. Asks for confirmation first; not reversible from inside the app, so run Find Duplicate Series first and check its output.">Merge Duplicate Series</button>
        <!-- Hand-picked one-time cleanup, added 2026-11-24 right after -
             the user's real Find Duplicate Series scan turned up exactly
             these two rows (Darkness, Zatanna) and asked for a plain
             delete of the new duplicate instead of a merge, specifically
             so the established issue's Publisher/Description/etc. are
             never touched at all. See AutoFetchService.
             DeleteKnownDuplicateSeries - hardcoded to these two series
             ids, not a general tool. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunDeleteKnownDuplicateSeries" title="One-time cleanup, hardcoded to the exact two duplicate series found tonight (Darkness #1972, Zatanna #1973) - deletes just those two rows outright and leaves the established series (#1706, #1761) completely untouched. Asks for confirmation first.">Delete Known Duplicates (Darkness/Zatanna)</button>
        <!-- Added 2026-11-24, same night - the store asked for Lunar
             history "as far back as it goes... then as far into the
             future as possible", not just the one current week Fetch
             Lunar Release (auto) covers. Walks the site's own date-nav
             chain in both directions and imports every real week it finds
             (see AutoFetchService.BackfillAllLunarHistory). This is
             dozens of file downloads in one run, so it's gated behind a
             confirm() warning how long it can take, same spirit as the
             merge/delete buttons above (though this one only ever adds
             data - it never deletes or changes anything already in
             inventory). -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunBackfillAllLunarHistory" title="Walks lunardistribution.com's own date-nav as far back and as far forward as it goes, downloading and importing every week that has real data - roughly a year or more of history both directions. Can take several minutes; only ever adds/updates inventory, never deletes anything.">Backfill All Lunar History</button>
        <!-- Added 2026-11-24 after the real backfill run above left some
             Lunar covers with no real UPC (see AutoFetchService.
             AddMissingCoverVariants - that bug is fixed now, but existing
             placeholder rows from before the fix still need clearing out).
             See AutoFetchService.DeleteLunarPlaceholderCovers's own doc
             comment for exactly what this can identify and delete - only
             Lunar covers that fell back to a generated barcode, never one
             that already got a real UPC. Confirm-gated, same as the
             Darkness/Zatanna cleanup above. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunDeleteLunarPlaceholderCovers" title="Deletes any Lunar-imported cover that never got a real UPC (still shows a generated 'LUN-' barcode) - the ones left broken before today's enrichment fix. A Lunar cover that already has a real UPC is left alone. Also removes any issue/series that ends up with nothing left on it. Asks for confirmation first; not reversible from inside the app.">Delete Lunar Placeholders</button>
        <!-- Dev/demo seed data, added 2026-11-24 - see AutoFetchService.
             GenerateFakeCustomersAndSalesHistory's own doc comment for
             exactly what "real" means here (any non-placeholder cover
             already in inventory, not literally only Lunar's) and why
             it's safe to click more than once. Not confirm-gated like the
             delete buttons above - this only ever ADDS data, it never
             removes or changes anything that was already there besides
             decrementing stock the same way a real sale would. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunGenerateFakeSeedData" title="Adds 15 fake customers, 60 fake past sales, and a few fake pull-list subscriptions per customer, drawn from whatever real (non-placeholder) covers are already in inventory, so Dashboard/History/Customers/FOC Report/Who's Pulling This all have something to show. Decrements stock for each fake sale (never below 0 - simulates receiving a few copies first if needed). Safe to run more than once - existing customers and subscriptions aren't duplicated, new fake sales just keep piling on.">Generate Fake Sales History</button>
        <!-- Added 2026-11-24 - fixes persistent pixelation on covers that
             were already saved before ComicVineService was fixed to prefer
             Comic Vine's larger "super_url" image (every cover before today
             was saved at the smaller "medium_url" size). Checks each
             cover's actual saved image width and only touches ones under
             ~400px, and only when an exact series+issue match is found on
             Comic Vine - never deletes or guesses, just swaps in a higher-
             resolution copy where a confident one exists. See
             AutoFetchService.UpgradeLowResolutionCovers. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunUpgradeLowResolutionCovers" title="Checks every cover's actual saved image size and re-fetches a higher-resolution copy from Comic Vine for any that are low-res - auto-links the series to Comic Vine first if it isn't already, then only swaps the cover when an exact issue match is found there. Never deletes anything; a cover with no confident match is left untouched.">Upgrade Low-Res Covers</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunUpgradeLowResolutionCoversTest" title="Same as Upgrade Low-Res Covers, but stops after 5 covers - use this first to confirm it's picking the right ones before running it against the whole catalog.">Upgrade Low-Res Covers (Test 5)</button>
        <!-- Added 2026-11-25/26 - see AutoFetchService.
             BackfillCoversFromPrhImageCdn's own doc comment. Different from
             Upgrade Low-Res Covers above: that one only swaps in a BETTER
             image for a cover that already has SOME image on file; this one
             fills in a cover that's completely BLANK (most of what the
             67-catalog PRH fetch just added) by looking its own barcode up
             directly against PRH's public cover-image service - no Comic
             Vine match needed at all, since the barcode IS the lookup key. -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunBackfillPrhCovers" title="Looks up every cover with nothing on file yet whose barcode is a real ISBN-13 or a full UPC+addon - PRH's own catalog-wide barcode shapes - directly against PRH's own public cover-image service. No Comic Vine match needed; a barcode with nothing on file there is just left blank.">Backfill PRH/ISBN Covers</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunBackfillPrhCoversTest" title="Same as Backfill PRH/ISBN Covers, but stops after 5 covers - use this first to confirm it's finding the right images before running it against everything.">Backfill PRH/ISBN Covers (Test 5)</button>
        <!-- Added 2026-11-26 - see AutoFetchService.
             BackfillCoverVariantsFromPrhBookPages's own doc comment.
             Different from the two PRH buttons above: those only ever
             touch a cover's IMAGE (BackfillCoversFromPrhImageCdn) once a
             Cover row already exists for it. This one finds covers that
             don't exist in this app's database AT ALL YET - a real Cover
             B/C/D/etc. PRH has on file for an issue that currently only
             shows "Cover A" here - by reading each issue's own
             prhcomics.com product page, and gives each one its own real,
             distinct barcode (not Bug #16's derived "{barcode}#{letter}"
             placeholder). -->
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunBackfillPrhCoverVariants" title="Visits each issue's own prhcomics.com product page (using whichever cover's barcode is already on file) and reads its 'Additional covers' section - adds a real Cover row, with its own real barcode, for any sibling cover this app doesn't have on file yet, and upgrades a derived/placeholder barcode to the real one where it finds a match. An issue with nothing more listed there is left untouched.">Backfill PRH Cover Variants</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunBackfillPrhCoverVariantsTest" title="Same as Backfill PRH Cover Variants, but stops after 5 issues - use this first to confirm it's finding real variants before running it against everything.">Backfill PRH Cover Variants (Test 5)</button>
    </div>
</div>

@if (_checking)
{
    <p class="help-text"><span class="spinner"></span> @_status</p>
}

@if (_resultMessage != null)
{
    <p class="help-text" style="background:var(--accent-soft);padding:8px 12px;border-radius:8px">&#10003; Done &mdash; @_resultMessage</p>
    @if (!string.IsNullOrWhiteSpace(_resultTrace))
    {
        <details style="margin:-4px 0 12px">
            <summary class="help-text" style="cursor:pointer;display:inline">Show full log</summary>
            <pre class="log-trace">@_resultTrace</pre>
        </details>
    }
}

@if (_showMonthTabs)
{
    @* Was a flat row of one pill per distinct month, then one dropdown
       listing every "Month Year" combo (2026-11-24: "too many months
       available... make it a better selection option"). Removing
       GetNewBooks' +/-3-month cap (2026-11-26, see AutoFetchService.
       GetNewBooks's own doc comment) immediately grew that one dropdown
       to 70+ entries spanning 2021-2027. Same-day follow-up: "make the
       selection where you just choose a month then a year [so] only
       around 16 options not 70." Two short dropdowns (12 month names +
       however many distinct years _monthTabs actually has) replace the
       one long one. Picking BOTH still produces the exact same
       "Month Year" string SelectMonth always expected, so none of this
       page's filtering/week-pill logic below needed to change - only
       one (or neither) picked just falls back to "All months", same as
       before. *@
    <div class="toolbar" style="margin-top:-8px">
        <select value="@SelectedMonthNamePart" @onchange="@(e => OnMonthNameChanged(e.Value?.ToString()))">
            <option value="">All months</option>
            @foreach (var monthName in MonthNameOptions)
            {
                <option value="@monthName">@monthName</option>
            }
        </select>
        <select value="@SelectedYearPart" @onchange="@(e => OnYearChanged(e.Value?.ToString()))">
            <option value="">All years</option>
            @foreach (var year in AvailableYears)
            {
                <option value="@year">@year</option>
            }
        </select>
        @if (_selectedMonthLabel != _currentMonthLabel && _monthTabs.Contains(_currentMonthLabel))
        {
            <button class="btn-ghost btn-sm" @onclick="@(() => SelectMonth(_currentMonthLabel))">Jump to current month</button>
        }
    </div>
}

@if (_showMonthTabs && _selectedMonthLabel != null && _weekStarts.Count > 1)
{
    @* Task #85 (2026-11-24): "add a buttons like how the monts used to
       look before for quickly selcting which week to look at" - brought
       back as a pill row, reusing the .month-pills/.month-pill CSS the
       OLD month-pill row used before that became the dropdown above (see
       its own doc comment for why a year-plus of months needed a
       dropdown instead). A single selected month only ever has a
       handful of weeks in it, so a pill row still works fine here and
       matches what the store actually asked to get back. Only shown
       once a specific month is picked (and only when that month has
       more than one distinct week) - "all months" has nothing single
       week-row-worth of weeks to show. *@
    <div class="month-pills">
        <button class="month-pill @(_selectedWeekStart == null ? "active" : "")" @onclick="@(() => SelectWeek(null))">All weeks</button>
        @foreach (var week in _weekStarts)
        {
            <button class="month-pill @(_selectedWeekStart == week ? "active" : "")" @onclick="@(() => SelectWeek(week))">@week.ToString("MMM d", CultureInfo.InvariantCulture)</button>
        }
    </div>
}

@if (_displayRows.Count == 0)
{
    <p class="empty-state">No new books found in the current window.</p>
}
else
{
    <table class="pos-table">
        <thead><tr><th></th><th>Series</th><th>Issue #</th><th>Publisher</th><th>FOC Date</th><th>Release Date</th></tr></thead>
        <tbody>
            @foreach (var row in _displayRows)
            {
                @if (row.IsHeader)
                {
                    <tr style="background:var(--accent-soft);font-weight:700;color:var(--accent)">
                        <td colspan="6">@row.HeaderText</td>
                    </tr>
                }
                else if (row.Issue != null)
                {
                    <tr style="cursor:pointer" @onclick="@(() => OpenDetail(row.Issue))">
                        <td>
                            <img class="cover-thumb" alt=""
                                 src="@(ThumbnailSrc(row.Issue))"
                                 onerror="this.onerror=null;this.src='/img/no-cover.svg';" />
                        </td>
                        <td>@row.Issue.Series.Name (@row.Issue.Series.StartYear)</td>
                        <td>@row.Issue.IssueNumber.ToString("0.##")</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Issue.Publisher) ? "" : row.Issue.Publisher)</td>
                        <td>@(row.Issue.FocDate?.ToString("MM/dd/yyyy") ?? "")</td>
                        <td>@(row.Issue.ReleaseDate?.ToString("MM/dd/yyyy") ?? "")</td>
                    </tr>
                }
            }
        </tbody>
    </table>

    @if (_totalPages > 1)
    {
        @* Numbered pagination, added 2026-11-24 to replace the old
           unlimited scroll within a selected month - matches the plain
           "previous 1 2 3 ... next" convention the user asked for instead
           of an endless table. *@
        <div class="toolbar" style="margin-top:10px;flex-wrap:wrap;align-items:center">
            <button class="btn-ghost btn-sm" disabled="@(_currentPage == 1)" @onclick="@(() => GoToPage(_currentPage - 1))">&laquo; previous</button>
            @foreach (var p in GetPageNumbersToShow())
            {
                @if (p == null)
                {
                    <span class="help-text" style="padding:0 2px">&hellip;</span>
                }
                else
                {
                    <button class="@(p == _currentPage ? "btn-primary btn-sm" : "btn-ghost btn-sm")" @onclick="@(() => GoToPage(p.Value))">@p</button>
                }
            }
            <button class="btn-ghost btn-sm" disabled="@(_currentPage == _totalPages)" @onclick="@(() => GoToPage(_currentPage + 1))">next &raquo;</button>
            <span class="help-text" style="margin-left:10px">
                Showing @((_currentPage - 1) * PageSize + 1)&ndash;@(Math.Min(_currentPage * PageSize, _totalIssueCount)) of @_totalIssueCount
            </span>
        </div>
    }
}

<NewBookDetailModal Show="_showDetail" Issue="_detailIssue" OnClose="@(() => _showDetail = false)" />

@code {
    private const string SortTitle = "Title";
    private const string SortPublisher = "Publisher";
    private const string SortFoc = "FOC Date";
    private const string SortRelease = "Release Date";

    private const string TypeFilterAll = "All";
    private const string TypeFilterSingle = "Single Issue";
    private const string TypeFilterCollected = "Collected Edition";

    private string _sortBy = SortRelease;
