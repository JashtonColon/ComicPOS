@page "/new-books"
@using System.Globalization
@using ComicPos.Core.Models
@using ComicPos.Core.Services
@inject IAutoFetchService AutoFetch
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>New Books - Comic POS</PageTitle>

<div class="page-header">
    <h1>New Books</h1>
</div>

<div class="toolbar">
    <input type="text" class="search-box" placeholder="Search New Books by series or publisher..." value="@_search" @oninput="OnSearchInput" />
    <div style="display:flex;gap:10px;align-items:center">
        <select value="@_sortBy" @onchange="OnSortChanged">
            <option value="@SortRelease">Release Date</option>
            <option value="@SortFoc">FOC Date</option>
            <option value="@SortPublisher">Publisher</option>
            <option value="@SortTitle">Title</option>
        </select>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRescan">Re-scan Existing</button>
        <!-- Metron is now the primary discovery source (2026-11-22),
             replacing LOCG in that role - a plain token-authenticated
             REST API with no Cloudflare check to click through and a
             far gentler, documented rate limit than LOCG's own ~4-5
             minute AJAX quota window. Pulls a rolling window (recent
             past through several months out) so FOC deadlines surface
             with real lead time, not just this week's shipping books.
             Re-scan Existing (Comic Vine/Metron/GCD) still runs
             separately as the cover-art/volume-link fallback for
             already-known series. RunCheckNow/AutoFetch.
             CheckForNewIssues (the original ComicList-based path) and
             RunLocgBackfill are both still here in code, just not the
             primary button any more - LOCG is kept as a manual fallback
             underneath for whatever Metron doesn't have on file. -->
        <button class="btn-primary btn-sm" disabled="@_checking" @onclick="RunMetronCheckNow" title="Pulls every issue Metron has on file with a street date from 2 weeks ago through 4 months out - recent misses plus enough lead time to see FOC deadlines coming. A plain REST API call, no browser window needed.">Check Now (Metron)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunMetronBackfillYear" title="Pulls all of @DateTime.Today.Year from Metron in one go - for rebuilding history after a catalog reset, not routine use.">Backfill @DateTime.Today.Year (Metron)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunLocgBackfill" title="Fallback only - pulls every week of @DateTime.Today.Year from League of Comic Geeks. Opens a real Chrome window and needs an occasional manual Cloudflare click; LOCG only lets a request through every few minutes, so a full year can take several hours.">Check Now (LOCG, fallback)</button>
        <button class="btn-ghost btn-sm" disabled="@_checking" @onclick="RunRetryMetronEnrichment" title="One-time catch-up for issues Metron already added whose price/UPC/description never came through (a detail-call failure when they were first added) - fills those in and pulls in any cover variants that were missed too. Only needs running once per affected batch, not routine.">Retry Metron Enrichment</button>
    </div>
</div>

@if (_checking)
{
    <p class="help-text"><span class="spinner"></span> @_status</p>
}

@if (_resultMessage != null)
{
    <p class="help-text" style="background:var(--accent-soft);padding:8px 12px;border-radius:8px">&#10003; Done &mdash; @_resultMessage</p>
    @if (!string.IsNullOrWhiteSpace(_resultTrace))
    {
        <details style="margin:-4px 0 12px">
            <summary class="help-text" style="cursor:pointer;display:inline">Show full log</summary>
            <pre class="log-trace">@_resultTrace</pre>
        </details>
    }
}

@if (_showMonthTabs)
{
    <div class="month-pills">
        <span class="month-pill @(_selectedMonthLabel == null ? "active" : "")" @onclick="@(() => SelectMonth(null))">All</span>
        @foreach (var month in _monthTabs)
        {
            <span class="month-pill @(_selectedMonthLabel == month ? "active" : "")" @onclick="@(() => SelectMonth(month))">@month</span>
        }
        <span class="month-pill" style="margin-left:auto;font-weight:400;opacity:0.7" @onclick="@(() => SelectMonth(_currentMonthLabel))">Jump to current month</span>
    </div>
}

@if (_displayRows.Count == 0)
{
    <p class="empty-state">No new books found in the current window.</p>
}
else
{
    <table class="pos-table">
        <thead><tr><th></th><th>Series</th><th>Issue #</th><th>Publisher</th><th>FOC Date</th><th>Release Date</th></tr></thead>
        <tbody>
            @foreach (var row in _displayRows)
            {
                @if (row.IsHeader)
                {
                    <tr style="background:var(--accent-soft);font-weight:700;color:var(--accent)">
                        <td colspan="6">@row.HeaderText</td>
                    </tr>
                }
                else if (row.Issue != null)
                {
                    <tr style="cursor:pointer" @onclick="@(() => OpenDetail(row.Issue))">
                        <td>
                            <img class="cover-thumb" alt=""
                                 src="@(ThumbnailSrc(row.Issue))"
                                 onerror="this.onerror=null;this.src='/img/no-cover.svg';" />
                        </td>
                        <td>@row.Issue.Series.Name (@row.Issue.Series.StartYear)</td>
                        <td>@row.Issue.IssueNumber.ToString("0.##")</td>
                        <td>@(string.IsNullOrWhiteSpace(row.Issue.Publisher) ? "" : row.Issue.Publisher)</td>
                        <td>@(row.Issue.FocDate?.ToString("MM/dd/yyyy") ?? "")</td>
                        <td>@(row.Issue.ReleaseDate?.ToString("MM/dd/yyyy") ?? "")</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}

<NewBookDetailModal Show="_showDetail" Issue="_detailIssue" OnClose="@(() => _showDetail = false)" />

@code {
    private const string SortTitle = "Title";
    private const string SortPublisher = "Publisher";
    private const string SortFoc = "FOC Date";
    private const string SortRelease = "Release Date";

    private string _sortBy = SortRelease;
    private string _search = "";
    private string _status = "";
    private string? _resultMessage;
    private string? _resultTrace;
    private bool _checking;

    private bool _showMonthTabs;
    private List<string> _monthTabs = new();
    private string? _selectedMonthLabel;
    private bool _monthFilterInitialized;
    private readonly string _currentMonthLabel = DateTime.Today.ToString("MMMM yyyy", CultureInfo.InvariantCulture);

    private List<DisplayRow> _displayRows = new();

    private bool _showDetail;
    private Issue? _detailIssue;

    private class DisplayRow
    {
        public bool IsHeader { get; set; }
        public string? HeaderText { get; set; }
        public Issue? Issue { get; set; }
    }

    protected override void OnInitialized() => RefreshGrid();

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        RefreshGrid();
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        // A month label from one sort (e.g. a FOC month) has no meaning
        // under another (e.g. sorted by Publisher) - drop back to "All".
        _sortBy = e.Value?.ToString() ?? SortRelease;
        _selectedMonthLabel = null;
        _monthFilterInitialized = false;
        RefreshGrid();
    }

    private async Task SelectMonth(string? label)
    {
        _selectedMonthLabel = label;
        _monthFilterInitialized = true;
        RefreshGrid();
        // Switching tabs re-renders the table in place (no page
        // navigation happens), so the browser doesn't naturally scroll
        // back up on its own the way a full page load would - without
        // this, clicking a tab while scrolled partway down a long list
        // can look like the click "didn't go all the way back."
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { /* best effort */ }
    }

    private void OpenDetail(Issue issue)
    {
        _detailIssue = issue;
        _showDetail = true;
    }

    private static string ThumbnailSrc(Issue issue)
    {
        var coverWithImage = issue.Covers.FirstOrDefault(c => !string.IsNullOrWhiteSpace(c.CoverImagePath) && File.Exists(c.CoverImagePath));
        return coverWithImage != null ? $"/api/cover-image/{coverWithImage.Id}" : "/img/no-cover.svg";
    }

    private void UpdateStatusLabel()
    {
        var last = AutoFetch.LastCheckedAt();
        _status = last != null
            ? $"Last checked: {last:g}  •  checks automatically about once a week"
            : "Never checked yet  •  checks automatically about once a week";
    }

    private static string GroupLabelFor(Issue issue, string sortKey) => sortKey switch
    {
        SortPublisher => string.IsNullOrWhiteSpace(issue.Publisher) ? "(Unknown Publisher)" : issue.Publisher,
        SortFoc => issue.FocDate?.ToString("MMMM yyyy") ?? "(No FOC Date)",
        SortTitle => issue.Series.Name,
        _ => issue.ReleaseDate?.ToString("MMMM yyyy") ?? "(No Release Date)"
    };

    private void RefreshGrid()
    {
        UpdateStatusLabel();

        IEnumerable<Issue> issues = AutoFetch.GetNewBooks();

        var searchText = _search.Trim();
        if (searchText.Length > 0)
        {
            issues = issues.Where(i =>
                i.Series.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                (!string.IsNullOrWhiteSpace(i.Publisher) && i.Publisher.Contains(searchText, StringComparison.OrdinalIgnoreCase)));
        }

        IEnumerable<Issue> ordered = _sortBy switch
        {
            SortPublisher => issues.OrderBy(i => i.Publisher).ThenBy(i => i.Series.Name).ThenBy(i => i.IssueNumber),
            SortFoc => issues.OrderBy(i => i.FocDate ?? DateOnly.MaxValue).ThenBy(i => i.Series.Name),
            SortTitle => issues.OrderBy(i => i.Series.Name).ThenBy(i => i.IssueNumber),
            _ => issues.OrderBy(i => i.ReleaseDate ?? DateOnly.MaxValue).ThenBy(i => i.Series.Name)
        };

        var orderedList = ordered.ToList();

        var monthCapableSort = _sortBy == SortRelease || _sortBy == SortFoc;
        _showMonthTabs = monthCapableSort;

        if (monthCapableSort)
        {
            var months = orderedList.Select(i => GroupLabelFor(i, _sortBy)).Distinct().ToList();
            _monthTabs = months
                .OrderBy(label => DateTime.TryParseExact(label, "MMMM yyyy", CultureInfo.InvariantCulture, DateTimeStyles.None, out var dt) ? dt : DateTime.MaxValue)
                .ToList();

            if (!_monthFilterInitialized)
            {
                // First load (or just after a sort change): default to
                // the current month instead of "All", so old months stay
                // out of sight until explicitly asked for. Falls back to
                // "All" only if there's genuinely nothing for this month.
                _selectedMonthLabel = _monthTabs.Contains(_currentMonthLabel) ? _currentMonthLabel : null;
                _monthFilterInitialized = true;
            }
            else if (_selectedMonthLabel != null && !_monthTabs.Contains(_selectedMonthLabel))
            {
                _selectedMonthLabel = null;
            }

            if (_selectedMonthLabel != null)
                orderedList = orderedList.Where(i => GroupLabelFor(i, _sortBy) == _selectedMonthLabel).ToList();
        }
        else
        {
            _monthTabs = new List<string>();
        }

        _displayRows = new List<DisplayRow>();
        string? lastGroupValue = null;
        var showInlineHeader = _sortBy != SortTitle && !(monthCapableSort && _selectedMonthLabel != null);

        foreach (var issue in orderedList)
        {
            var groupValue = GroupLabelFor(issue, _sortBy);
            if (showInlineHeader && groupValue != lastGroupValue)
            {
                _displayRows.Add(new DisplayRow { IsHeader = true, HeaderText = groupValue });
                lastGroupValue = groupValue;
            }
            _displayRows.Add(new DisplayRow { IsHeader = false, Issue = issue });
        }
    }

    private async Task RunCheckNow()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Checking for new issues... this can take a minute.";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.CheckForNewIssues());
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Check failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Checked {result.SeriesChecked} series, linked {result.SeriesAutoLinked} new one(s), added {result.NewIssuesAdded} new issue(s).";
            if (result.Errors.Count > 0)
                summary += " Some series had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    private async Task RunMetronCheckNow()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        var after = DateOnly.FromDateTime(DateTime.Today.AddDays(-14));
        var before = DateOnly.FromDateTime(DateTime.Today.AddDays(120));
        _status = $"Checking Metron for issues from {after:MM/dd/yyyy} through {before:MM/dd/yyyy}...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.CheckForNewIssuesViaMetron(after, before, progressLine =>
            {
                InvokeAsync(() =>
                {
                    _status = progressLine;
                    StateHasChanged();
                });
            }));
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Metron check failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Added {result.NewIssuesAdded} new issue(s) from Metron ({after:MM/dd/yyyy} - {before:MM/dd/yyyy}).";
            if (result.Errors.Count > 0)
                summary += " Some weeks had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    private async Task RunMetronBackfillYear()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        var year = DateTime.Today.Year;
        var after = new DateOnly(year, 1, 1);
        var before = new DateOnly(year, 12, 31);
        _status = $"Backfilling {year} from Metron...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.CheckForNewIssuesViaMetron(after, before, progressLine =>
            {
                InvokeAsync(() =>
                {
                    _status = progressLine;
                    StateHasChanged();
                });
            }));
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Metron backfill failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Added {result.NewIssuesAdded} new issue(s) from Metron for {year}.";
            if (result.Errors.Count > 0)
                summary += " Some weeks had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    private async Task RunRetryMetronEnrichment()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Re-checking Metron for issues whose price/UPC/description never came through...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.RetryMetronEnrichment(progressLine =>
            {
                InvokeAsync(() =>
                {
                    _status = progressLine;
                    StateHasChanged();
                });
            }));
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Metron retry-enrichment failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Re-enriched {result.Added.Count} issue(s) from Metron.";
            if (result.Errors.Count > 0)
                summary += " Some issues had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    private async Task RunLocgBackfill()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        var year = DateTime.Today.Year;
        _status = $"Backfilling {year} from League of Comic Geeks... this opens a real Chrome window. LOCG only lets a request through every few minutes, so a full year can take several hours - leave it running in the background. Starting with the first week...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            // onProgress fires on the background Task.Run thread, not
            // Blazor Server's own synchronization context - InvokeAsync
            // marshals the _status update (and the re-render it needs)
            // back onto the circuit's thread, the same way any other
            // cross-thread UI update has to in Blazor Server. Without
            // this, the status line would just sit on its one starting
            // message for the entire multi-hour run - indistinguishable
            // from actually being stuck.
            result = await Task.Run(() => AutoFetch.BackfillYearFromLocg(year, progressLine =>
            {
                InvokeAsync(() =>
                {
                    _status = progressLine;
                    StateHasChanged();
                });
            }));
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"LOCG backfill failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Added {result.NewIssuesAdded} new issue(s) from LOCG for {year}.";
            if (result.Errors.Count > 0)
                summary += " Some weeks had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    private async Task RunRescan()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Re-scanning existing books for better volume links and missing covers... this can take a while for a large catalog.";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.RescanExistingBooks());
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Re-scan failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Checked {result.SeriesChecked} series, re-linked {result.SeriesAutoLinked}, backfilled {result.CoversBackfilled} cover(s).";
            if (result.Errors.Count > 0)
                summary += " Some series had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }
}
