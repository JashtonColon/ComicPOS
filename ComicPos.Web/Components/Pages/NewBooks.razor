    // The two dropdowns' own displayed values, parsed back out of
    // _selectedMonthLabel (the one "Month Year" string everything else on
    // this page already keys off - SelectMonth, the filtering above, the
    // week pills) instead of tracked as separate fields, so there's only
    // ever one source of truth and nothing can drift out of sync with it
    // (e.g. right after "Jump to current month" changes _selectedMonthLabel
    // directly, without going through either dropdown at all).
    private string SelectedMonthNamePart =>
        string.IsNullOrEmpty(_selectedMonthLabel) ? "" : _selectedMonthLabel.Split(' ', 2)[0];

    private string SelectedYearPart =>
        !string.IsNullOrEmpty(_selectedMonthLabel) && _selectedMonthLabel.Split(' ', 2).Length == 2
            ? _selectedMonthLabel.Split(' ', 2)[1]
            : "";

    // Only the years _monthTabs actually has an entry for, so the Year
    // dropdown always matches whichever sort (Release date vs FOC date) is
    // active right now, same as _monthTabs itself.
    private List<string> AvailableYears =>
        _monthTabs
            .Select(label => label.Split(' ', 2))
            .Where(parts => parts.Length == 2 && int.TryParse(parts[1], out _))
            .Select(parts => parts[1])
            .Distinct()
            .OrderBy(year => year)
            .ToList();

    private Task OnMonthNameChanged(string? monthName) =>
        ApplyMonthYear(string.IsNullOrEmpty(monthName) ? null : monthName, string.IsNullOrEmpty(SelectedYearPart) ? null : SelectedYearPart);

    private Task OnYearChanged(string? year) =>
        ApplyMonthYear(string.IsNullOrEmpty(SelectedMonthNamePart) ? null : SelectedMonthNamePart, string.IsNullOrEmpty(year) ? null : year);

    // Needs BOTH a month name and a year before there's anything specific
    // to filter to - picking just one (the other still "All") falls back
    // to "All months", same as picking "All months" directly always has.
    private Task ApplyMonthYear(string? monthName, string? year) =>
        SelectMonth(monthName != null && year != null ? $"{monthName} {year}" : null);

    private async Task SelectMonth(string? label)
    {
        _selectedMonthLabel = label;
        _monthFilterInitialized = true;
        // A week pill from the PREVIOUS month has no meaning under a new
        // one (or under "All months") - drop back to "All weeks".
        _selectedWeekStart = null;
        _currentPage = 1;
        RefreshGrid();
        // Switching tabs re-renders the table in place (no page
        // navigation happens), so the browser doesn't naturally scroll
        // back up on its own the way a full page load would - without
        // this, clicking a tab while scrolled partway down a long list
        // can look like the click "didn't go all the way back."
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { /* best effort */ }
    }

    private async Task SelectWeek(DateOnly? weekStart)
    {
        _selectedWeekStart = weekStart;
        _currentPage = 1;
        RefreshGrid();
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { /* best effort */ }
    }

    // Monday of the week containing this date - matches the Monday-based
    // weekly cadence the rest of the app already organizes releases by
    // (see AutoFetchService.RunBackfillYearFromLocg, which walks every
    // Monday). DateOnly.DayOfWeek: Sunday=0..Saturday=6; this maps
    // Monday=0..Sunday=6 instead so subtracting it always lands on the
    // Monday on/before the given date.
    private static DateOnly WeekStart(DateOnly date) => date.AddDays(-(((int)date.DayOfWeek + 6) % 7));

    private DateOnly GroupWeekFor(Issue issue) =>
        WeekStart(_sortBy == SortFoc ? (issue.FocDate ?? DateOnly.MaxValue) : (issue.ReleaseDate ?? DateOnly.MaxValue));

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages || page == _currentPage) return;
        _currentPage = page;
        RefreshGrid();
        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { /* best effort */ }
    }

    // Windowed page-number list (first, last, a small range around the
    // current page, null entries rendered as "...") so a month with
    // hundreds of pages doesn't render hundreds of page-number buttons.
    private List<int?> GetPageNumbersToShow()
    {
        var pages = new List<int?>();
        if (_totalPages <= 9)
        {
            for (var i = 1; i <= _totalPages; i++) pages.Add(i);
            return pages;
        }

        pages.Add(1);
        var start = Math.Max(2, _currentPage - 2);
        var end = Math.Min(_totalPages - 1, _currentPage + 2);
        if (start > 2) pages.Add(null);
        for (var i = start; i <= end; i++) pages.Add(i);
        if (end < _totalPages - 1) pages.Add(null);
        pages.Add(_totalPages);
        return pages;
    }

