    private async Task OnLunarFileSelected(InputFileChangeEventArgs e)
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = $"Reading {e.File.Name}...";
        StateHasChanged();

        // A real weekly release file runs several MB (it embeds a cover
        // photo for every row) - InputFile's own default cap is a tiny
        // 500KB, which rejects any real file outright without a much
        // larger explicit limit here.
        var tempPath = Path.Combine(Path.GetTempPath(), $"lunar_{Guid.NewGuid():N}.xlsx");
        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            await using (var fs = File.Create(tempPath))
            {
                await e.File.OpenReadStream(maxAllowedSize: 100_000_000).CopyToAsync(fs);
            }

            result = await Task.Run(() => AutoFetch.ImportLunarDistributionRelease(tempPath, progressLine =>
            {
                InvokeAsync(() =>
                {
                    _status = progressLine;
                    StateHasChanged();
                });
            }));
        }
        catch (Exception ex)
        {
            error = ex;
        }
        finally
        {
            try { File.Delete(tempPath); } catch { /* best-effort cleanup only */ }
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Lunar Distribution import failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Imported {e.File.Name}: {result.NewIssuesAdded} new issue(s) added.";
            if (result.Errors.Count > 0)
                summary += $" {result.Errors.Count} row(s) had issues (see details below).";
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

