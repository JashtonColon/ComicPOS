            "This walks lunardistribution.com's full release/FOC history - roughly a year or more of weekly files in each direction - downloading and importing every week that has real data. It can take several minutes and makes a lot of requests to lunardistribution.com. It only ever adds/updates inventory; nothing is deleted.\n\nContinue?");
        if (!confirmed) return;

        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Starting full Lunar history backfill...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() =>
            {
                // Deliberately not AutoFetch (the page's circuit-scoped
                // instance) - see this method's own comment above.
                using var scope = ScopeFactory.CreateScope();
                var scopedAutoFetch = scope.ServiceProvider.GetRequiredService<IAutoFetchService>();
                return scopedAutoFetch.BackfillAllLunarHistory(progressLine =>
                {
                    InvokeAsync(() =>
                    {
                        _status = progressLine;
                        StateHasChanged();
                    });
                });
            });
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Lunar history backfill failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Backfilled Lunar history: {result.NewIssuesAdded} new issue(s) added across every week found.";
            if (result.Errors.Count > 0)
                summary += $" {result.Errors.Count} row(s)/week(s) had issues (see details below).";
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    // Same own-DI-scope reasoning as RunBackfillAllLunarHistory below -
    // this can run for a long time (60+ catalogs, each its own
    // download+import), long enough for the tab's circuit to drop before
    // it finishes, which would otherwise dispose the DbContext this is
    // still saving against on a background thread.
    private async Task RunFetchAllPrhCatalogs()
    {
        if (_checking) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            "This finds and downloads EVERY catalog prhcomics.com's own archive currently lists - 2021 through whatever's newest right now, 60+ months - instead of just the one catalog code above. It can take a long time and makes a lot of requests to prhcomics.com. It only ever adds/updates inventory; nothing is deleted.\n\nContinue?");
        if (!confirmed) return;

        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Finding every available PRH catalog...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() =>
            {
                // Deliberately not AutoFetch (the page's circuit-scoped
                // instance) - see this method's own comment above.
                using var scope = ScopeFactory.CreateScope();
                var scopedAutoFetch = scope.ServiceProvider.GetRequiredService<IAutoFetchService>();
                return scopedAutoFetch.FetchAllAvailablePrhCatalogsFromWebsite(progressLine =>
                {
                    InvokeAsync(() =>
                    {
                        _status = progressLine;
                        StateHasChanged();
                    });
                });
            });
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"PRH full-history fetch failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Fetched every available PRH catalog: {result.NewIssuesAdded} new issue(s) added across every month found.";
            if (result.Errors.Count > 0)
                summary += $" {result.Errors.Count} row(s)/catalog(s) had issues (see details below).";
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    private async Task RunLocgBackfill()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        var year = DateTime.Today.Year;
        _status = $"Backfilling {year} from League of Comic Geeks... this opens a real Chrome window. LOCG only lets a request through every few minutes, so a full year can take several hours - leave it running in the background. Starting with the first week...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            // onProgress fires on the background Task.Run thread, not
            // Blazor Server's own synchronization context - InvokeAsync
            // marshals the _status update (and the re-render it needs)
            // back onto the circuit's thread, the same way any other
            // cross-thread UI update has to in Blazor Server. Without
            // this, the status line would just sit on its one starting
            // message for the entire multi-hour run - indistinguishable
            // from actually being stuck.
            result = await Task.Run(() => AutoFetch.BackfillYearFromLocg(year, progressLine =>
            {
                InvokeAsync(() =>
                {
                    _status = progressLine;
                    StateHasChanged();
                });
            }));
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"LOCG backfill failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Added {result.NewIssuesAdded} new issue(s) from LOCG for {year}.";
            if (result.Errors.Count > 0)
                summary += " Some weeks had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

    // Second fallback, added 2026-11-24 with both Metron (IP/Cloudflare
    // blocked) and LOCG (Cloudflare now actively rejecting the manual
    // click too - see metron-integration-notes.md) down at the same
    // time. This calls the ORIGINAL AutoFetchService.CheckForNewIssues() -
    // ComicList + Extended Forecast + Comicade FOC + Comic Vine new-#1
    // discovery, the four-source pipeline that ran this app before
    // Metron existed. Still fully wired up and working, just demoted to
    // "not the default" once Metron became primary - nothing new had to
    // be built here, just a button pointing at code that was already
    // there. No onProgress parameter on this one (unlike the Metron/LOCG
    // methods) - every source it calls is a plain HTTP/REST request, so
    // a full run is seconds, not hours, and doesn't need a live status
    // line to avoid looking hung.
    private async Task RunCheckForNewIssues()
    {
        if (_checking) return;
        _checking = true;
        _resultMessage = null;
        _resultTrace = null;
        _status = "Checking ComicList, Extended Forecast, Comicade FOC, and Comic Vine (no Metron, no LOCG, no Cloudflare)...";

        AutoFetchResult? result = null;
        Exception? error = null;
        try
        {
            result = await Task.Run(() => AutoFetch.CheckForNewIssues());
        }
        catch (Exception ex)
        {
            error = ex;
        }

        _checking = false;

        if (error != null)
        {
            _resultMessage = $"Check failed: {error.Message}";
        }
        else if (result != null)
        {
            var summary = $"Checked {result.SeriesChecked} series, linked {result.SeriesAutoLinked}, added {result.NewIssuesAdded} new issue(s), backfilled {result.CoversBackfilled} cover(s).";
            if (result.Errors.Count > 0)
                summary += " Some sources had errors: " + string.Join("; ", result.Errors.Take(10));
            _resultMessage = summary;
            _resultTrace = result.Trace;
        }

        RefreshGrid();
    }

