@page "/history"
@using ComicPos.Core.Models
@using ComicPos.Core.Services
@inject ISalesHistoryService HistoryService
@inject ICheckoutService Checkout
@rendermode InteractiveServer

<PageTitle>History - Comic POS</PageTitle>

<div class="page-header">
    <h1>Sales History</h1>
</div>

<div class="breadcrumb">
    @if (_level > 0)
    {
        <button class="btn-ghost btn-sm" @onclick="GoBack">&larr; Back</button>
    }
    <h1>@BreadcrumbText</h1>
</div>

@if (_voidError != null)
{
    <p class="error-text">@_voidError</p>
}

@if (_level == 0)
{
    @if (_seriesNames.Count == 0)
    {
        <p class="empty-state">No sales on file yet.</p>
    }
    else
    {
        <div class="toolbar">
            <ClearableSearchBox Value="@_search" Placeholder="Search series..." OnInput="OnSearchInput" />
        </div>
        @if (_filteredSeriesNames.Count == 0)
        {
            <p class="empty-state">No series match "@_search".</p>
        }
        <div class="list-rows">
            @foreach (var name in _filteredSeriesNames)
            {
                <div class="list-row" style="cursor:pointer" @onclick="@(() => GoToIssueList(name))">
                    <div class="list-row-main"><span class="list-row-title">@name</span></div>
                </div>
            }
        </div>
    }
}
else if (_level == 1)
{
    @if (_issueRows.Count == 0)
    {
        <p class="empty-state">No issues with sales on file for this series.</p>
    }
    else
    {
        <table class="pos-table">
            <thead><tr><th>Issue #</th><th>Publisher</th></tr></thead>
            <tbody>
                @foreach (var issue in _issueRows)
                {
                    <tr style="cursor:pointer" @onclick="@(() => GoToSaleDetail(issue))">
                        <td>@issue.IssueNumber.ToString("0.##")</td>
                        <td>@issue.Publisher</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else if (_level == 2)
{
    @if (_saleLines.Count == 0)
    {
        <p class="empty-state">No sales on file for this issue.</p>
    }
    else
    {
        <table class="pos-table">
            <thead><tr><th>Cover</th><th>Quantity</th><th>Price Each</th><th>Discount</th><th>Sold At</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var line in _saleLines)
                {
                    <tr style="@(line.Sale.IsVoided ? "color:var(--text-muted)" : "")">
                        <td>@line.Cover.CoverLetter</td>
                        <td>@line.Quantity</td>
                        <td>@line.PriceEach.ToString("C")</td>
                        <td>@line.DiscountPercent.ToString("0.0")%</td>
                        <td>@line.Sale.SoldAt.ToString("g")</td>
                        <td>@(line.Sale.IsVoided ? "VOIDED" : "")</td>
                        <td>
                            @if (!line.Sale.IsVoided)
                            {
                                <button class="btn-ghost btn-sm btn-remove" @onclick="@(() => RequestVoid(line))">Void Sale</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@if (_confirmVoidLine != null)
{
    <Modal Show="true" Title="Void Sale" OnBackdropClick="CancelVoid">
        <p>Void this entire sale from @_confirmVoidLine.Sale.SoldAt.ToString("g")? This restores stock for every item on that sale.</p>
        <div class="form-actions">
            <button class="btn-ghost" @onclick="CancelVoid">Cancel</button>
            @* btn-remove only actually shows (border-color with nothing to
               render it against on a border:none btn-primary) on a ghost-
               style button - same btn-ghost+btn-remove combo Checkout's
               own Remove button uses, see app.css's .btn-remove comment. *@
            <button class="btn-ghost btn-remove" @onclick="ConfirmVoid">Void Sale</button>
        </div>
    </Modal>
}

@code {
    // 0 = All Series, 1 = Issue List, 2 = Sale Detail.
    private int _level;
    private string? _seriesName;
    private int? _issueId;
    private float? _issueNumber;

    private List<string> _seriesNames = new();
    private List<Issue> _issueRows = new();
    private List<SaleLine> _saleLines = new();
    private string? _voidError;
    private SaleLine? _confirmVoidLine;

    // Added 2026-11-24 (user asked for a search box on History - the
    // "All Series" list has no other way to narrow a long sales history
    // down to one series). Plain substring match, same as Inventory's own
    // series search.
    private string _search = "";
    private List<string> _filteredSeriesNames => string.IsNullOrWhiteSpace(_search)
        ? _seriesNames
        : _seriesNames.Where(n => n.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    private void OnSearchInput(ChangeEventArgs e) => _search = e.Value?.ToString() ?? "";

    protected override void OnInitialized() => LoadSeriesList();

    private string BreadcrumbText => _level switch
    {
        0 => "All Series",
        1 => $"{_seriesName} — Issues",
        2 => $"{_seriesName} #{_issueNumber:0.##} — Sales",
        _ => ""
    };

    private void LoadSeriesList()
    {
        _level = 0;
        _seriesName = null;
        _issueId = null;
        _issueNumber = null;
        _voidError = null;
        _seriesNames = HistoryService.GetSeriesWithSales();
    }

    private void GoToIssueList(string seriesName)
    {
        _level = 1;
        _seriesName = seriesName;
        _issueId = null;
        _issueNumber = null;
        _voidError = null;
        _issueRows = HistoryService.GetIssuesWithSales(seriesName);
    }

    private void GoToSaleDetail(Issue issue)
    {
        _level = 2;
        _issueId = issue.Id;
        _issueNumber = issue.IssueNumber;
        _voidError = null;
        LoadSaleDetail();
    }

    private void LoadSaleDetail()
    {
        if (_issueId == null) return;
        _saleLines = HistoryService.GetSalesForIssue(_issueId.Value);
    }

    private void GoBack()
    {
        if (_level == 2) GoToIssueList(_seriesName!);
        else if (_level == 1) LoadSeriesList();
    }

    private void RequestVoid(SaleLine line)
    {
        _voidError = null;
        if (line.Sale.IsVoided)
        {
            _voidError = "That sale is already voided.";
            return;
        }
        _confirmVoidLine = line;
    }

    private void CancelVoid() => _confirmVoidLine = null;

    private void ConfirmVoid()
    {
        if (_confirmVoidLine == null) return;
        try
        {
            Checkout.VoidSale(_confirmVoidLine.SaleId);
        }
        catch (Exception ex)
        {
            _voidError = ex.Message;
        }
        _confirmVoidLine = null;
        LoadSaleDetail();
    }
}
