@* Task #82 (2026-11-24): "a new page showing the same book data as New
   Books but grouped/displayed BY SERIES rather than by release month."
   Deliberately reuses the FULL catalog (SearchSeriesForDisplay/
   GetIssuesForSeries - the same unfiltered "everything ever discovered"
   data source Customers.razor's pull-list subscribe picker and New Books
   both already use), not Inventory's received-only view - the point here
   is browsing the whole catalog by series, the same scope New Books
   already covers, just grouped differently. Also deliberately reuses
   Inventory.razor's own series-list drill-down pattern (search box +
   list-rows, see that file's own LoadSeriesList/GoToTypeChoice) and the
   existing shared NewBookDetailModal for the per-issue cover/variant
   detail popup, instead of building a parallel detail view from scratch -
   same popup New Books already opens, same "Add to a Subscriber's Pull
   List" action included for free. *@
@page "/series-browse"
@using ComicPos.Core.Models
@using ComicPos.Core.Services
@inject IInventoryService InventoryService
@rendermode InteractiveServer

<PageTitle>Series Browse - Comic POS</PageTitle>

<div class="page-header">
    <h1>Series Browse</h1>
</div>

<div class="toolbar">
    <ClearableSearchBox Value="@_search" Placeholder="Search series name..." OnInput="OnSearchInput" />
</div>

<div class="breadcrumb">
    @if (_selectedSeriesName != null)
    {
        <button class="btn-ghost btn-sm" @onclick="GoBackToSeriesList">&larr; Back</button>
    }
    <h1>@(_selectedSeriesName ?? "All Series")</h1>
</div>

@if (_selectedSeriesName == null)
{
    @if (_seriesRows.Count == 0)
    {
        <p class="empty-state">@(string.IsNullOrWhiteSpace(_search) ? "No series on file yet." : "No series match that search.")</p>
    }
    else
    {
        <div class="list-rows">
            @foreach (var s in _seriesRows)
            {
                <div class="list-row" style="cursor:pointer" @onclick="@(() => SelectSeries(s.Name))">
                    <div class="list-row-main">
                        <span class="list-row-title">@s.Name</span>
                        <span class="list-row-sub">@s.StartYear</span>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    @if (_issueRows.Count == 0)
    {
        <p class="empty-state">No issues on file for this series yet.</p>
    }
    else
    {
        <table class="pos-table">
            <thead>
                <tr><th></th><th>Issue #</th><th>Type</th><th>Publisher</th><th>Release Date</th><th>FOC Date</th><th>Price</th><th>Stock</th></tr>
            </thead>
            <tbody>
                @foreach (var issue in _issueRows)
                {
                    var primaryCover = issue.Covers.OrderBy(c => c.CoverLetter).FirstOrDefault();
                    <tr style="cursor:pointer" @onclick="@(() => OpenDetail(issue))">
                        <td>
                            <img class="cover-thumb-detail" src="@(HasImage(primaryCover) ? $"/api/cover-image/{primaryCover!.Id}" : "/img/no-cover.svg")"
                                 alt="cover" onerror="this.onerror=null;this.src='/img/no-cover.svg';" />
                        </td>
                        <td>@issue.IssueNumber.ToString("0.##")</td>
                        <td>@(issue.Type == IssueType.CollectedEdition ? "Collected Edition" : "Single Issue")</td>
                        <td>@issue.Publisher</td>
                        <td>@(issue.ReleaseDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                        <td>@(issue.FocDate?.ToString("MM/dd/yyyy") ?? "—")</td>
                        <td>@(primaryCover != null && primaryCover.Price > 0 ? primaryCover.Price.ToString("C") : "—")</td>
                        <td>@issue.Covers.Sum(c => c.StockQuantity)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<NewBookDetailModal Show="_showDetail" Issue="_detailIssue" OnClose="@(() => _showDetail = false)" />

@code {
    private string _search = "";
    private string? _selectedSeriesName;
    private List<Series> _seriesRows = new();
    private List<Issue> _issueRows = new();

    private bool _showDetail;
    private Issue? _detailIssue;

    protected override void OnInitialized() => LoadSeriesList();

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        LoadSeriesList();
    }

    private void LoadSeriesList()
    {
        _selectedSeriesName = null;
        _issueRows = new();
        // Alphabetical - neither SearchSeriesForDisplay nor the DB itself
        // guarantees an order, and a full-catalog browse page is exactly
        // where that matters most for actually finding something.
        _seriesRows = InventoryService.SearchSeriesForDisplay(_search).OrderBy(s => s.Name).ToList();
    }

    private void GoBackToSeriesList() => LoadSeriesList();

    private void SelectSeries(string seriesName)
    {
        _selectedSeriesName = seriesName;
        // Both types together, sorted by issue number - unlike Inventory's
        // drill-down, there's no separate "choose type" stop here: a
        // series browse is meant to show everything for that series in
        // one place, with Type called out as its own column instead.
        var single = InventoryService.GetIssuesForSeries(seriesName, IssueType.SingleIssue);
        var collected = InventoryService.GetIssuesForSeries(seriesName, IssueType.CollectedEdition);
        _issueRows = single.Concat(collected).OrderBy(i => i.IssueNumber).ToList();
    }

    private void OpenDetail(Issue issue)
    {
        _detailIssue = issue;
        _showDetail = true;
    }

    private static bool HasImage(Cover? cover) =>
        cover != null && !string.IsNullOrWhiteSpace(cover.CoverImagePath) && File.Exists(cover.CoverImagePath);
}
