@* Reusable "pick a customer, then subscribe them to a series' ongoing
   pull list" modal - a near-twin of HoldCopyModal, but for ongoing
   subscriptions instead of a one-off hold. Pull lists are tracked per
   SERIES (see PullListEntry), not per issue, so subscribing here means
   the customer gets this issue AND every future issue of the series
   automatically - the modal says so plainly rather than implying a
   one-time add. AddToPullList() on the service is already idempotent
   (re-adding reactivates/updates instead of duplicating), so this modal
   also surfaces an existing subscription up front rather than letting
   someone be surprised by that after the fact. *@
@namespace ComicPos.Web.Components.Shared
@using ComicPos.Core.Models
@using ComicPos.Core.Services
@inject ICustomerService Customers
@inject IPullListService PullLists

<Modal Show="Show" Title="Add to a Pull List" OnBackdropClick="Close">
    <p class="help-text" style="font-weight:600;color:var(--text)">@SeriesLabel</p>
    <p class="help-text">Subscribing adds this series to the customer's ongoing pull list - they'll get this issue and every future issue automatically, not just this one.</p>

    <div class="form-row">
        <label>Subscribe which customer?</label>
        <input type="text" class="search-box" style="margin-bottom:6px" value="@_searchText" @oninput="OnSearchInput" placeholder="Search customer by name..." />
    </div>

    @* Fixed-height box, always rendered (never toggled in/out of the DOM),
       so typing a search or picking a customer never makes the modal
       suddenly jump in height - only its contents change. *@
    <div class="list-rows" style="height:140px;overflow-y:auto;margin-bottom:6px;border:1px solid var(--border);border-radius:8px">
        @if (_selectedCustomer != null)
        {
            <div class="list-row" style="padding:10px 12px">
                <div class="list-row-main"><div class="list-row-title">Selected: @_selectedCustomer.Name</div></div>
            </div>
        }
        else if (_results.Count > 0)
        {
            @foreach (var c in _results)
            {
                <div class="list-row" style="cursor:pointer" @onclick="() => PickCustomer(c)">
                    <div class="list-row-main"><div class="list-row-title">@c.Name</div></div>
                </div>
            }
        }
        else
        {
            <p class="help-text" style="padding:10px 12px;margin:0">@(string.IsNullOrWhiteSpace(_searchText) ? "Start typing a name above to search." : "No customers match that search.")</p>
        }
    </div>
    @if (_selectedCustomer != null && _alreadySubscribed)
    {
        <p class="help-text" style="color:var(--text-muted);margin:-2px 0 12px">Already on this customer's pull list for this series - saving will update their cover/quantity/notes below instead of adding a duplicate.</p>
    }

    <div class="form-row-split">
        <div class="form-row">
            <label>Cover:*</label>
            <input list="pull-add-cover-letters" value="@_cover" @oninput="e => _cover = e.Value?.ToString() ?? string.Empty" maxlength="1" />
            <datalist id="pull-add-cover-letters">
                @foreach (var letter in KnownCoverLetters)
                {
                    <option value="@letter"></option>
                }
            </datalist>
        </div>
        <div class="form-row">
            <label>Quantity:*</label>
            <input type="number" min="1" value="@_quantity" @oninput="e => int.TryParse(e.Value?.ToString(), out _quantity)" />
        </div>
    </div>

    <div class="form-row">
        <label>Notes:</label>
        <textarea rows="3" value="@_notes" @oninput="e => _notes = e.Value?.ToString() ?? string.Empty"></textarea>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error-text">@_error</p>
    }

    <div class="form-actions">
        <button class="btn-ghost" @onclick="Close">Cancel</button>
        <button class="btn-primary" @onclick="Save">@(_alreadySubscribed ? "Update Subscription" : "Add to Pull List")</button>
    </div>
</Modal>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public int SeriesId { get; set; }
    [Parameter] public string SeriesLabel { get; set; } = "";
    [Parameter] public List<string> KnownCoverLetters { get; set; } = new();
    [Parameter] public string DefaultCoverLetter { get; set; } = "A";
    [Parameter] public EventCallback<(int CustomerId, string CoverLetter, int Quantity, string? Notes)> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string _searchText = "";
    private List<Customer> _results = new();
    private Customer? _selectedCustomer;
    private bool _alreadySubscribed;
    private string _cover = "A";
    private int _quantity = 1;
    private string _notes = "";
    private string? _error;
    private bool _wasShown;

    protected override void OnParametersSet()
    {
        if (Show && !_wasShown)
        {
            _searchText = "";
            _results = new();
            _selectedCustomer = null;
            _alreadySubscribed = false;
            _cover = DefaultCoverLetter;
            _quantity = 1;
            _notes = "";
            _error = null;
        }
        _wasShown = Show;
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? "";
        _selectedCustomer = null;
        _alreadySubscribed = false;
        _results = string.IsNullOrWhiteSpace(_searchText) ? new() : Customers.SearchCustomers(_searchText);
    }

    private void PickCustomer(Customer c)
    {
        _selectedCustomer = c;
        _searchText = c.Name;
        _results = new();

        var existing = PullLists.GetForCustomer(c.Id).FirstOrDefault(p => p.SeriesId == SeriesId);
        if (existing != null)
        {
            _alreadySubscribed = true;
            _cover = existing.PreferredCoverLetter;
            _quantity = existing.Quantity;
            _notes = existing.Notes ?? "";
        }
        else
        {
            _alreadySubscribed = false;
        }
    }

    private async Task Save()
    {
        _error = null;
        if (_selectedCustomer == null) { _error = "Pick a customer from the search results first."; return; }

        var cover = (_cover ?? "").Trim().ToUpperInvariant();
        if (cover.Length != 1 || !char.IsLetter(cover[0])) { _error = "Cover letter must be a single letter (A, B, C, ...)."; return; }

        if (_quantity < 1) { _error = "Quantity must be a whole number, 1 or more."; return; }

        await OnSave.InvokeAsync((_selectedCustomer.Id, cover, _quantity, string.IsNullOrWhiteSpace(_notes) ? null : _notes.Trim()));
    }

    private async Task Close() => await OnClose.InvokeAsync();
}
