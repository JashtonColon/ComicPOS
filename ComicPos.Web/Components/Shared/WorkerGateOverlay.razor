@* Register lock screen - added 2026-11-24 for the worker PIN + 1-minute
   inactivity lockout. MainLayout renders this IN PLACE OF @Body (not on
   top of it as a dismissible modal/backdrop) whenever the current route
   is gated and nobody's logged in, or the register has auto-locked from
   inactivity - see MainLayout's own GatedRoutes/ShowGate comments.
   Picker + PIN UI deliberately mirrors WorkerLoginModal's (same
   Worker/IWorkerService, same "pick a name, type a PIN" flow) rather
   than sharing code with it - this one is never dismissible (no
   backdrop click, no Close button) since the whole point is that a
   gated page simply isn't usable until someone logs in here. *@
@namespace ComicPos.Web.Components.Shared
@using ComicPos.Core.Models
@using ComicPos.Core.Services
@using ComicPos.Web.Services
@inject IWorkerService WorkerService
@inject CurrentWorkerContext CurrentWorker

<div class="pos-gate">
    <div class="pos-gate-card">
        <div class="pos-gate-heading">@(CurrentWorker.IsLocked ? "Register Locked" : "Who's Working?")</div>
        <p class="help-text">
            @(CurrentWorker.IsLocked
                ? "Locked after a minute of inactivity - enter a PIN to keep going."
                : "Pick your name and enter your PIN to use this page.")
        </p>

        @if (_selectedWorker == null)
        {
            <div class="list-rows">
                @foreach (var w in _workers)
                {
                    <div class="list-row" style="cursor:pointer" @onclick="@(() => PickWorker(w))">
                        <div class="list-row-main"><span class="list-row-title">@w.Name</span></div>
                    </div>
                }
            </div>
            @if (_workers.Count == 0)
            {
                <p class="help-text">No workers set up yet - add one from the Settings page.</p>
            }
        }
        else
        {
            <p class="list-row-title" style="margin-bottom:10px">@_selectedWorker.Name</p>
            <div class="form-row">
                <label>PIN:</label>
                <input type="password" inputmode="numeric" maxlength="8" value="@_pin" @ref="_pinInputRef"
                       @oninput="e => _pin = e.Value?.ToString() ?? string.Empty"
                       @onkeydown="HandlePinKeyDown" />
            </div>
            @if (_error != null)
            {
                <p class="error-text">@_error</p>
            }
            <div class="form-actions">
                <button class="btn-ghost" @onclick="@(() => _selectedWorker = null)">Back</button>
                <button class="btn-primary" @onclick="ConfirmLogin">Unlock</button>
            </div>
        }
    </div>
</div>

@code {
    private List<Worker> _workers = new();
    private Worker? _selectedWorker;
    private string _pin = "";
    private string? _error;
    private bool _focusPinNext;
    private ElementReference _pinInputRef;

    protected override void OnInitialized()
    {
        _workers = WorkerService.GetActiveWorkers();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPinNext)
        {
            _focusPinNext = false;
            try { await _pinInputRef.FocusAsync(); }
            catch { /* best effort */ }
        }
    }

    private void PickWorker(Worker w)
    {
        _selectedWorker = w;
        _pin = "";
        _error = null;
        _focusPinNext = true;
    }

    private async Task HandlePinKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await ConfirmLogin();
    }

    private Task ConfirmLogin()
    {
        if (_selectedWorker == null) return Task.CompletedTask;

        var worker = WorkerService.TryLogin(_selectedWorker.Id, _pin);
        if (worker == null)
        {
            _error = "Wrong PIN - try again.";
            return Task.CompletedTask;
        }

        // Clears IsLocked and sets Current - MainLayout's ShowGate
        // re-evaluates on CurrentWorker.Changed and swaps back to @Body.
        CurrentWorker.SetCurrent(worker);
        return Task.CompletedTask;
    }
}
