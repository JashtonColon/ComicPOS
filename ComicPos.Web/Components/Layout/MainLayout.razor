@namespace ComicPos.Web.Components.Layout
@inherits LayoutComponentBase
@using ComicPos.Web.Services
@inject NavigationManager Nav
@inject CurrentWorkerContext CurrentWorker
@implements IDisposable

<div class="pos-shell">
    <nav class="pos-sidebar">
        <div class="pos-brand">Comic<span>POS</span></div>

        <div class="pos-nav-group">
            <a href="" class="pos-nav-item @ActiveClass("")" @onclick="@(() => GoTo(""))" @onclick:preventDefault>Dashboard</a>
            <a href="inventory" class="pos-nav-item @ActiveClass("inventory")" @onclick="@(() => GoTo("inventory"))" @onclick:preventDefault>Inventory</a>
            <a href="checkout" class="pos-nav-item @ActiveClass("checkout")" @onclick="@(() => GoTo("checkout"))" @onclick:preventDefault>Checkout</a>
            <a href="history" class="pos-nav-item @ActiveClass("history")" @onclick="@(() => GoTo("history"))" @onclick:preventDefault>History</a>
            <a href="customers" class="pos-nav-item @ActiveClass("customers")" @onclick="@(() => GoTo("customers"))" @onclick:preventDefault>Customers</a>
        </div>

        <div class="pos-nav-group">
            <div class="pos-nav-heading">Stock</div>
            <a href="import" class="pos-nav-item @ActiveClass("import")" @onclick="@(() => GoTo("import"))" @onclick:preventDefault>Import</a>
            <a href="new-books" class="pos-nav-item @ActiveClass("new-books")" @onclick="@(() => GoTo("new-books"))" @onclick:preventDefault>New Books</a>
            <a href="foc-report" class="pos-nav-item @ActiveClass("foc-report")" @onclick="@(() => GoTo("foc-report"))" @onclick:preventDefault>FOC Report</a>
        </div>

        <div class="pos-nav-group pos-nav-group-bottom">
            <div class="pos-worker-chip" @onclick="OpenWorkerLogin">
                <div class="pos-worker-chip-label">Working as</div>
                <div class="pos-worker-chip-name">@(CurrentWorker.Current?.Name ?? "Not set")</div>
                <button class="btn-ghost btn-sm" style="width:100%;margin-top:6px" @onclick="OpenWorkerLogin" @onclick:stopPropagation>Switch</button>
            </div>
            <a href="settings" class="pos-nav-item @ActiveClass("settings")" @onclick="@(() => GoTo("settings"))" @onclick:preventDefault>Settings</a>
        </div>
    </nav>

    <main class="pos-main">
        @Body
    </main>
</div>

<WorkerLoginModal Show="_showWorkerLogin" OnClose="CloseWorkerLogin" />

@code {
    private bool _showWorkerLogin;

    protected override void OnInitialized()
    {
        CurrentWorker.Changed += OnWorkerChanged;

        // NavLink normally re-renders itself on every navigation to keep
        // its "active" class current - since plain <a> tags are used here
        // instead (see GoTo's comment for why NavLink itself can't be used
        // with @onclick:preventDefault), that re-render has to be done by
        // hand: re-render this layout whenever the URL changes so
        // ActiveClass() gets re-evaluated with the new current page.
        Nav.LocationChanged += OnLocationChanged;
    }

    private void OnWorkerChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private void OpenWorkerLogin() => _showWorkerLogin = true;

    private void CloseWorkerLogin() => _showWorkerLogin = false;

    public void Dispose()
    {
        CurrentWorker.Changed -= OnWorkerChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private string ActiveClass(string relativeHref) => IsSamePage(relativeHref) ? "active" : "";

    private bool IsSamePage(string relativeHref)
    {
        var target = Nav.ToAbsoluteUri(relativeHref).ToString().TrimEnd('/');
        var current = Nav.Uri.TrimEnd('/');
        return string.Equals(current, target, StringComparison.OrdinalIgnoreCase);
    }

    // Blazor's router never re-runs a page's OnInitialized for a
    // navigation to the exact URL it's already on - clicking "Inventory"
    // while already deep in an Inventory drill-down (Series > Issue >
    // Covers) would otherwise silently do nothing, which read as "the
    // tab doesn't go all the way back." Taking over every nav click here
    // (preventDefault + do it ourselves) means a same-page click can ask
    // for a real reload instead - every page component starts fresh,
    // resetting whatever internal drill-down/filter state it had, the
    // same as a brand new visit to that page.
    //
    // This uses plain <a> tags instead of NavLink: Blazor's compiler
    // doesn't allow @onclick:preventDefault together with an explicit
    // @onclick handler on a COMPONENT like NavLink (only on a real HTML
    // element) - it's an RZ10010 "parameter used twice" build error, not a
    // runtime issue. ActiveClass() above replicates the "active" styling
    // NavLink would have given for free.
    private void GoTo(string relativeHref)
    {
        var isSamePage = IsSamePage(relativeHref);
        Nav.NavigateTo(relativeHref, forceLoad: isSamePage);
    }
}
