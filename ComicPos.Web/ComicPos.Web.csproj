<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Comic POS already runs on one register at a time - bind to
         localhost only, same trust boundary as the desktop app had. -->
    <UserSecretsId>comicpos-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ComicPos.Core\ComicPos.Core.csproj" />
    <ProjectReference Include="..\ComicPos.Data\ComicPos.Data.csproj" />
    <ProjectReference Include="..\ComicPos.Importers\ComicPos.Importers.csproj" />
  </ItemGroup>

</Project>
