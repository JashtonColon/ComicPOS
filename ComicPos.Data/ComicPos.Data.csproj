<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ComicPos.Core\ComicPos.Core.csproj" />
    <ProjectReference Include="..\ComicPos.Importers\ComicPos.Importers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <!-- Used by ComicListService to parse comiclist.info's weekly master
         shipping-list post. A real HTML parser instead of hand-rolled
         regex tag-stripping, which breaks the moment the markup changes
         even slightly. -->
    <PackageReference Include="HtmlAgilityPack" Version="1.11.72" />
    <!-- Used by LocgService - leagueofcomicgeeks.com sits behind
         Cloudflare bot-protection, so plain HTTP (what ComicListService/
         GcdService use) doesn't work against it; this drives a real
         Chrome window instead. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
