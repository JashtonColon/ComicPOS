<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ComicPos.Core\ComicPos.Core.csproj" />
    <ProjectReference Include="..\ComicPos.Data\ComicPos.Data.csproj" />
    <ProjectReference Include="..\ComicPos.Importers\ComicPos.Importers.csproj" />
  </ItemGroup>

  <!-- dotnet-ef needs this on whichever project is passed as the
       startup project, not just on the project holding the DbContext
       (ComicPos.Data already has it), or "dotnet ef migrations add"
       fails before it ever gets to the DbContext. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>